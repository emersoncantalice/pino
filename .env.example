# Pino — configurações (copie para .env e preencha)

# Chave da API do Google Gemini, usada pelo agente "Foto → Post-its".
# Crie a sua em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo do Gemini (opcional).
#   gemini-4-carbon   → mais preciso para ler fotos e letra à mão (padrão)
#   gemini-4-hydrogen → mais rápido e mais barato
GEMINI_MODEL=gemini-4-carbon

# Porta do servidor (opcional, padrão 3000)
PORT=3000
